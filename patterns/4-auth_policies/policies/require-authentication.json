{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowAnyAuthenticatedPrincipal",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "vpc-lattice-svcs:Invoke",
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIgnoreCase": {
          "aws:PrincipalType": "anonymous"
        }
      }
    }
  ]
}
